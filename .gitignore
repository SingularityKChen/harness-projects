# 依赖
node_modules/
.pnpm-store/

# pnpm 的本地 XDG 重定向目录。项目 pin 了 pnpm 版本，而受限沙箱不允许它在
# workspace 之外创建临时安装目录，绕法是把 XDG_CACHE_HOME / XDG_DATA_HOME /
# XDG_STATE_HOME / TMPDIR 都指到仓库内的这个目录。它是本机运行态，不进版本库；
# 不写这一条的话 `git add -A` 会把它整个收进去（实测一次误收 515 个文件）。
.tmp-pnpm/

# 构建产物
dist/
build/
*.tsbuildinfo

# Agent 运行态（技能定义的临时工作区，永不提交）
# 参见 AGENTS.md「隔离工作区」与「文档规范」
.superpowers/
.worktrees/

# 本地上游设计输入（只读参考，不随仓库分发）
# 参见 AGENTS.md §1.5 与 docs/exec-plan/completed/2026-09-17-disclosure-audit-and-license.md
deepseek-harness-project-delivery-engineering-pack-v0.1/

# 本地数据与密钥
.env
.env.*
!.env.example
*.local
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db

# 测试与覆盖率
coverage/
.nyc_output/
test-results/
playwright-report/

# 编辑器 / 操作系统
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
