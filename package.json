{
  "name": "harness-projects",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "项目交付工作台：以可替换 Provider 组合 Planning / Development / Delivery / Execution 能力域",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node scripts/resolution-check.mjs && node scripts/run-test-layer.mjs tests/contract \"能力与包边界契约\" && node scripts/run-test-layer.mjs tests/integration \"持久化与跨层集成\" && node scripts/run-test-layer.mjs tests/e2e \"端到端链路与故障恢复\"",
    "test:contract": "node scripts/resolution-check.mjs && node --test tests/contract",
    "test:file": "node scripts/resolution-check.mjs && node --test --test-timeout=120000",
    "boundaries": "node scripts/resolution-check.mjs && node --test tests/contract/package-boundaries.test.js",
    "check:policy": "node scripts/policy-check.mjs",
    "verify": "pnpm run typecheck && pnpm run test",
    "test:browser": "node scripts/run-test-layer.mjs tests/browser \"生产组合浏览器读取与恢复\""
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-api-gateway": "0.2.0-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.0-rc.2",
    "@harness-projects/app-harness-plugin": "workspace:*",
    "@harness-projects/app-web": "workspace:*",
    "@harness-projects/capabilities": "workspace:*",
    "@harness-projects/client": "workspace:*",
    "@harness-projects/controller": "workspace:*",
    "@harness-projects/core": "workspace:*",
    "@harness-projects/domain": "workspace:*",
    "@harness-projects/provider-delivery-github-actions": "workspace:*",
    "@harness-projects/provider-development-github": "workspace:*",
    "@harness-projects/provider-development-local-git": "workspace:*",
    "@harness-projects/provider-execution-harness": "workspace:*",
    "@harness-projects/provider-execution-human": "workspace:*",
    "@harness-projects/provider-fake": "workspace:*",
    "@harness-projects/provider-planning-github-projects": "workspace:*",
    "@harness-projects/provider-planning-local": "workspace:*",
    "@harness-projects/storage-sqlite": "workspace:*",
    "@harness-projects/ui": "workspace:*",
    "@harness-projects/ui-model": "workspace:*",
    "@types/node": "~24.13.5",
    "playwright": "1.64.1",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  }
}
